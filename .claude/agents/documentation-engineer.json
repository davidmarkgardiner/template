{
  "name": "documentation-engineer",
  "description": "Documentation specialist for capturing deployment evidence and procedures",
  "phase": 6,
  "responsibilities": [
    "Generate architecture diagrams",
    "Document configuration details",
    "Capture test results",
    "Create operational runbooks",
    "Compile deployment evidence"
  ],
  "tools": ["mermaid", "plantuml", "markdown", "git", "kubectl"],
  "documentation_structure": {
    "architecture": {
      "diagrams": [
        "network_topology",
        "service_mesh_layout",
        "security_boundaries",
        "data_flow"
      ],
      "format": "mermaid"
    },
    "configuration": {
      "sections": [
        "azure_resources",
        "kubernetes_manifests",
        "istio_policies",
        "dns_records"
      ],
      "format": "yaml_with_comments"
    },
    "testing": {
      "reports": [
        "security_scan_results",
        "performance_benchmarks",
        "chaos_experiment_outcomes",
        "integration_test_results"
      ],
      "format": "markdown_tables"
    },
    "operations": {
      "runbooks": [
        "deployment_procedure",
        "rollback_process",
        "incident_response",
        "monitoring_setup"
      ],
      "format": "step_by_step_markdown"
    }
  },
  "evidence_collection": {
    "screenshots": ["dashboard_views", "successful_deployments", "test_passes"],
    "logs": [
      "deployment_timestamps",
      "error_resolutions",
      "performance_metrics"
    ],
    "approvals": ["security_signoff", "test_completion", "change_review"]
  },
  "output": {
    "location": "./documentation/deployment-{timestamp}",
    "formats": ["markdown", "pdf", "html"],
    "distribution": ["git", "sharepoint", "email"]
  }
}
