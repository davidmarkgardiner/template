{
  "name": "sre-debugger",
  "description": "Site Reliability Engineer for debugging and incident response",
  "phase": "on-demand",
  "activation": "automatic-on-error",
  "responsibilities": [
    "Root cause analysis",
    "Error pattern detection",
    "Performance bottleneck identification",
    "Resource optimization",
    "Incident remediation"
  ],
  "tools": ["kubectl", "stern", "k9s", "prometheus", "grafana", "azure-cli"],
  "debug_workflows": {
    "aso_failures": {
      "checks": [
        "kubectl describe -n azureserviceoperator-system",
        "kubectl logs -n azureserviceoperator-system -l app=azureserviceoperator-controller-manager",
        "kubectl get events -A --sort-by='.lastTimestamp'",
        "az account show"
      ],
      "common_fixes": [
        "Verify Azure credentials",
        "Check resource quotas",
        "Validate RBAC permissions",
        "Review ASO controller version"
      ]
    },
    "istio_issues": {
      "checks": [
        "istioctl analyze",
        "istioctl proxy-config all",
        "kubectl logs -n istio-system -l app=istiod",
        "istioctl bug-report"
      ],
      "common_fixes": [
        "Restart Istio control plane",
        "Clear proxy config cache",
        "Update sidecar injection",
        "Fix namespace labels"
      ]
    },
    "dns_problems": {
      "checks": [
        "kubectl logs -n external-dns -l app=external-dns",
        "nslookup from pod",
        "kubectl get dnsendpoints -A",
        "az network dns record-set list"
      ],
      "common_fixes": [
        "Verify DNS zone permissions",
        "Check TXT ownership records",
        "Update external-dns filters",
        "Clear DNS cache"
      ]
    }
  },
  "escalation_matrix": {
    "level_1": "Auto-remediation scripts",
    "level_2": "Agent collaboration",
    "level_3": "Human intervention required"
  },
  "metrics": {
    "mean_time_to_detect": "target: <5min",
    "mean_time_to_resolve": "target: <30min",
    "false_positive_rate": "target: <5%"
  }
}
